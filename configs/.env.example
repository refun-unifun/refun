# Copy to ".env" (or export these) before running. None of these are committed.
#
#   cp configs/.env.example .env
#   export $(grep -v '^#' .env | xargs)

# --- Datasets -------------------------------------------------------------
# HuggingFace account hosting the corpora. Deliberately NOT committed: naming
# it would break double-blind review. refun/datasets.py joins this to the bare
# repo names it stores, so `--datasets x64_O0` resolves to
# "$REFUN_HF_NAMESPACE/<repo name>". Without it, config names raise an
# explanatory error; fully-qualified repo IDs still work.
REFUN_HF_NAMESPACE=

# (Optional) HuggingFace token, only if the dataset repos are private.
# HF_TOKEN=

# --- Evaluation assets (both optional) ------------------------------------
# SentencePiece identifier-segmentation model for the token-level metric.
# If absent, identifier splitting falls back to camelCase/underscore rules.
REFUN_SP_MODEL=./assets/segmentation.model

# CodeWordNet word-cluster JSON for the CWordNet-F1 metric.
# If absent, CWordNet-F1 equals plain token-F1.
REFUN_WORD_CLUSTER=./assets/word_cluster.json

# Pass --require_assets to turn a missing asset into an error instead.

# --- Corpus construction (only for refun.data_prep) -----------------------
# Ghidra install directory, used by refun.data_prep.run_ghidra.
# GHIDRA_INSTALL_DIR=/opt/ghidra_11.2.1_PUBLIC

# Teacher LLM endpoint for reasoning-trace generation. Any OpenAI-compatible
# server works (vendor API, vLLM, llama.cpp, Ollama).
# REFUN_LLM_BASE_URL=
# REFUN_LLM_API_KEY=
