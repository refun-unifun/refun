# Copy to ".env" (or export these) before running. None of these are committed.

# Path to the SentencePiece identifier-segmentation model used by the
# token-level metric (TP/FP/FN over name subtokens).
REFUN_SP_MODEL=./assets/segmentation.model

# Path to the CodeWordNet word-cluster JSON used by the CWordNet-F1 metric.
REFUN_WORD_CLUSTER=./assets/word_cluster.json

# (Optional) HuggingFace token, only if your dataset repos are private.
# HF_TOKEN=
